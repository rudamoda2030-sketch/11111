# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MacCMS V10 Connection Configuration
MACCMS_BASE_URL=
MACCMS_PROVIDE_PATH=/api.php/provide/vod/
MACCMS_TIMEOUT_MS=10000
MACCMS_API_TOKEN=

# Parser API Security & Secret
PARSER_API_SECRET=
APP_PUBLIC_BASE_URL=
ALLOWED_PLAYBACK_HOSTS=

# Optional Database & Cache
DATABASE_URL=
CACHE_URL=
